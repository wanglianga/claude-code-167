{
  "name": "museum-accessible-visit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test:scenarios": "esbuild scripts/scenarios.ts --bundle --platform=node --format=esm --outfile=scripts/.scenarios.mjs && node scripts/.scenarios.mjs",
    "test:store": "esbuild scripts/store-smoke.ts --bundle --platform=node --format=esm --outfile=scripts/.store-smoke.mjs && node scripts/.store-smoke.mjs",
    "test:render": "esbuild scripts/render-smoke.tsx --bundle --platform=node --format=cjs --outfile=scripts/.render.cjs --loader:.css=empty && node scripts/.render.cjs",
    "test": "npm run test:scenarios && npm run test:store && npm run test:render"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "esbuild": "^0.24.0",
    "typescript": "~5.6.2",
    "vite": "^5.4.8"
  }
}
